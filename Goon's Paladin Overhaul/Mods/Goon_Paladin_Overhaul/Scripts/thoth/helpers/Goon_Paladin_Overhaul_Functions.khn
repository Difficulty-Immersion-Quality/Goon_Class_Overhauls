function Goon_IsSmiteSpells()
    return Goon_IsDivineSmite()
        -- Banishing Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Banishing')
         | IsSpellChildOrVariantFromContext('Projectile_Smite_Banishing')
        -- Blinding Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Blinding')
        -- Branding Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Branding')
         | IsSpellChildOrVariantFromContext('Projectile_Smite_Branding')
         | IsSpellChildOrVariantFromContext('Target_Smite_Branding_ZarielTiefling')
         | IsSpellChildOrVariantFromContext('Projectile_Smite_Branding_ZarielTiefling')
        -- Searing Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Searing')
         | IsSpellChildOrVariantFromContext('Target_Smite_Searing_ZarielTiefling')
         | IsSpellChildOrVariantFromContext('Target_FOR_Smite_Searing_DeathOfATrueSoul')
         | IsSpellChildOrVariantFromContext('Target_UND_Smite_Searing_DuergarBlacksmithHammer')
         | IsSpellChildOrVariantFromContext('Goon_Target_UND_Smite_Searing_DuergarBlacksmithHammer_Offhand')
        -- Staggering Smite
         | IsSpellChildOrVariantFromContext('Target_StaggeringSmite')
        -- Thunderous Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Thunderous') 
         | IsSpellChildOrVariantFromContext('Target_MAG_ThunderousSmite')
        -- Wrathful Smite
         | IsSpellChildOrVariantFromContext('Target_Smite_Wrathful') 
         | IsSpellChildOrVariantFromContext('Target_MAG_Smite_Wrathful')
        -- Lunar Smite - Vanilla and Xarara's Lunar Smite mod
         | IsSpellChildOrVariantFromContext('Target_LunarSmite')
         | IsSpellChildOrVariantFromContext('Target_MOO_Nightsong_SearingSmite')
         | IsSpellChildOrVariantFromContext('Target_LOW_RamazithsTower_Nightsong_Smite')
        -- Veenab stuff
         | IsSpellChildOrVariantFromContext('VBT_Spell_0_SappingBlade') 
         | IsSpellChildOrVariantFromContext('VBT_Spell_2_DrainingSmite_Container') 
         | IsSpellChildOrVariantFromContext('VBT_Target_LifeDrain') 
         | IsSpellChildOrVariantFromContext('VBT_Projectile_LifeDrain')
        -- Some dude's homebrew
         | IsSpellChildOrVariantFromContext('Target_Smite_Pitiless')
        -- Blackguard smites by Xarara
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_VENOMOUS')                            -- Venomous
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_VENOMOUS_BLOOD')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_CHILLING')                            -- Chilling
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_CHILLING_BLOOD')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_SILENCING')                           -- Silencing
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_SILENCING_BLOOD')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_CAUSTIC')                             -- Caustic
         | IsSpellChildOrVariantFromContext('PROJECTILE_SMITE_CAUSTIC')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_CAUSTIC_BLOOD')
         | IsSpellChildOrVariantFromContext('PROJECTILE_SMITE_CAUSTIC_BLOOD')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLINDING_SICKNESS')       -- Necrotising
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_FILTH_FEVER')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_FLESH_ROT')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_MINDFIRE')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_SEIZURE')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_SLIMY_DOOM')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_BLINDING_SICKNESS')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_FILTH_FEVER')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_FLESH_ROT')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_MINDFIRE')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_SEIZURE')
         | IsSpellChildOrVariantFromContext('TARGET_NECROTIZING_SMITE_BLOOD_SLIMY_DOOM')
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_VAMPIRIC')                            -- Vampiric
end
