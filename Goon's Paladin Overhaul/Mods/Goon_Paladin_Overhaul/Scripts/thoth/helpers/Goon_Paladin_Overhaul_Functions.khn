-- ==================================== Vanilla function overwrites ====================================
-- TODO: Check mods patched here for their interrupts if any...

function IsDivineSmite()
    return Goon_IsDivineSmite()
 --        SpellId('Target_Smite_Divine') 
 --      | SpellId('Target_Smite_Divine_2') 
 --      | SpellId('Target_Smite_Divine_3') 
 --      | SpellId('Target_Smite_Divine_4') 
 --      | SpellId('Target_Smite_Divine_5') 
 --      | SpellId('Target_Smite_Divine_6')
end

function Goon_IsDivineSmite()
    return IsSpellChildOrVariantFromContext('Target_Smite_Divine')
        -- I dunno 
         | IsSpellChildOrVariantFromContext('Target_RWI_Smite_Divine')
         | IsSpellChildOrVariantFromContext('Target_PPHB2024_Smite_Divine_Free')
        -- No idea, pulled from Xarara
         | ConditionResult(string.match(context.InterruptId, '^Interrupt_Smite_Unholy_Oathbreaker'))
        --  Unholy Smite for Oathbreakers by ChizFreak
         | IsSpellChildOrVariantFromContext('Target_CHIZ_Unholy_Smite')
         | IsSpellChildOrVariantFromContext('Target_CHIZ_Unholy_Smite_Free')
         | IsSpellChildOrVariantFromContext('Target_CHIZ_TEST_SMITE')
         | IsSpellChildOrVariantFromContext('Target_RWI_CHIZ_Unholy_Smite')
        -- Unholy Smite - Empowering Oathbreakers (And Other Paladin Subclasses) by GraphicFade  
         | IsSpellChildOrVariantFromContext('Target_Smite_Unholy_Oathbreaker')
        -- Beyond Divine Smite by GraphicFade
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Acid')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Chaos')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Cold')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Fire')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Force')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Lightning')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Necro')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Poison')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Psychic')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_Thunder')
         | IsSpellChildOrVariantFromContext('Target_Smite_Divine_War')
        -- Blackguard smites by Xarara
        -- TODO: Add support for Hell Knight and Death Knight subclass variants if they get released.
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_PROFANE') 
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_PROFANE_BLOOD') 
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_ENDARKENING') 
         | IsSpellChildOrVariantFromContext('TARGET_SMITE_ENDARKENING_TRUE') 
        -- Mizora's Rewards by malonkey1
         | IsSpellChildOrVariantFromContext('Target_Smite_Eldritch')
        -- Oathbreaker Reborn by K_Constantine and faceplug
         | IsSpellChildOrVariantFromContext('Target_Smite_Malicious') 
end

