-- ==================================== Draconic Bloodline - Elemental Affinity: Damage ====================================

function Goon_ElementalAffinityDamage(conditionalDamageSpell, target)
    target = target or context.Target

    local conditions = ~HasStatus('GOON_ONCEPERACTION_COOLDOWN_ELEMENTALAFFINITY', target)
                     & IsSpell()
                     & (Goon_IsSpellDamageTypeAcid()
                     | Goon_IsSpellDamageTypeCold()
                     | Goon_IsSpellDamageTypeFire()
                     | Goon_IsSpellDamageTypeLightning()
                     | Goon_IsSpellDamageTypePoison()
                     | Goon_IsSpellDamageTypeForce()
                     | Goon_IsSpellDamageTypeRadiant()
                     | Goon_IsSpellDamageTypePsychic()
                     | Goon_IsSpellDamageTypeThunder()
                     | Goon_IsSpellDamageTypeNecrotic()
                     | Goon_IsSpellDamageTypeBludgeoning()
                     | Goon_IsSpellDamageTypePiercing()
                     | Goon_IsSpellDamageTypeSlashing())

    if conditionalDamageSpell ~= nil then
        if conditionalDamageSpell then
            return conditions & Goon_IsConditionalDamageCantripEligible()
        else
            return conditions & ~Goon_IsConditionalDamageCantripEligible()
        end
    end

    return conditions
end

function Goon_EAD_Acid(conditionalDamageSpell, source, target)
    source = source or context.Source
    target = target or context.Target
    return Goon_ElementalAffinityDamage(conditionalDamageSpell, target)
         & Goon_DraconicAncestry_Acid(source)
         & Goon_IsSpellDamageTypeAcid()
end

