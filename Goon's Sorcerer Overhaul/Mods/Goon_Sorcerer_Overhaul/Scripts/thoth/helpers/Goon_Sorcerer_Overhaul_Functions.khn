-- ==================================== Draconic Bloodline - Elemental Affinity: Resistance ====================================

function Goon_NoElementalAffinityStatus(source)
    source = source or context.Source

    local result = ~HasAnyStatus({ 'ELEMENTALAFFINITY_ACID', 'ELEMENTALAFFINITY_COLD', 'ELEMENTALAFFINITY_FIRE', 'ELEMENTALAFFINITY_LIGHTNING', 'ELEMENTALAFFINITY_POISON', 'GOON_ELEMENTALAFFINITY_FORCE', 'ELEMENTALAFFINITY_FORCE', 'GOON_ELEMENTALAFFINITY_RADIANT', 'ELEMENTALAFFINITY_RADIANT', 'GOON_ELEMENTALAFFINITY_PSYCHIC', 'ELEMENTALAFFINITY_PSYCHIC', 'GOON_ELEMENTALAFFINITY_THUNDER', 'ELEMENTALAFFINITY_THUNDER', 'GOON_ELEMENTALAFFINITY_NECROTIC', 'ELEMENTALAFFINITY_NECROTIC', 'GOON_ELEMENTALAFFINITY_BLUDGEONING', 'ELEMENTALAFFINITY_BLUDGEONING', 'GOON_ELEMENTALAFFINITY_PIERCING', 'ELEMENTALAFFINITY_PIERCING', 'GOON_ELEMENTALAFFINITY_SLASHING', 'ELEMENTALAFFINITY_SLASHING' }, {}, {}, source)

    if not result.Result then
        return ConditionResult(false, { ConditionError('Goon_ElementalAffinity_Active') })
    end

    return result
end

function ElementalAffinityCheck(observer, source, target)
    observer = observer or context.Observer
    source = source or context.Source
    target = target or context.Target

    if not Goon_NoElementalAffinityStatus(observer).Result then
        return ConditionResult(false)
    end

    if Goon_EAD_Acid(nil, source, target).Result        then return ConditionResult(true) end
    if Goon_EAD_Cold(nil, source, target).Result        then return ConditionResult(true) end
    if Goon_EAD_Fire(nil, source, target).Result        then return ConditionResult(true) end
    if Goon_EAD_Lightning(nil, source, target).Result   then return ConditionResult(true) end
    if Goon_EAD_Poison(nil, source, target).Result      then return ConditionResult(true) end
    if Goon_EAD_Force(nil, source, target).Result       then return ConditionResult(true) end
    if Goon_EAD_Radiant(nil, source, target).Result     then return ConditionResult(true) end
    if Goon_EAD_Psychic(nil, source, target).Result     then return ConditionResult(true) end
    if Goon_EAD_Thunder(nil, source, target).Result     then return ConditionResult(true) end
    if Goon_EAD_Necrotic(nil, source, target).Result    then return ConditionResult(true) end
    if Goon_EAD_Bludgeoning(nil, source, target).Result then return ConditionResult(true) end
    if Goon_EAD_Piercing(nil, source, target).Result    then return ConditionResult(true) end
    if Goon_EAD_Slashing(nil, source, target).Result    then return ConditionResult(true) end

    return ConditionResult(false)
end

