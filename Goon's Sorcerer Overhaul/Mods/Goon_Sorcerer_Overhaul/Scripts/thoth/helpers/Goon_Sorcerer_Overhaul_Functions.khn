-- ==================================== Draconic Bloodline - Elemental Affinity: Damage ====================================

function Goon_ElementalAffinityDamage(conditionalDamageSpell, target)
    target = target or context.Target

    if not IsSpell().Result then
        return ConditionResult(false)
    end
    if HasStatus('GOON_ONCEPERACTION_COOLDOWN_ELEMENTALAFFINITY', target).Result then
        return ConditionResult(false)
    end

    if conditionalDamageSpell ~= nil then
        if conditionalDamageSpell then
            return Goon_IsConditionalDamageCantripEligible()
        else
            return ~Goon_IsConditionalDamageCantripEligible()
        end
    end

    return ConditionResult(true)
end

function Goon_EAD_Acid(conditionalDamageSpell, source, target)
    source = source or context.Source
    target = target or context.Target

    if not Goon_DraconicAncestry_Acid(source).Result then return ConditionResult(false) end
    if not Goon_IsSpellDamageTypeAcid().Result       then return ConditionResult(false) end

    return Goon_ElementalAffinityDamage(conditionalDamageSpell, target)
end

