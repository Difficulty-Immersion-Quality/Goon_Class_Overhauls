-- Death Domain was not included by Larian. Supports Expansion by Celes, Darkness Domain by Xarara, and 5e Subclasses Combined by Sumradagnoth.

function IsDivineStrike()
    -- return SpellId('Target_DivineStrike_Melee_Life')            -- Vanilla
        --  | SpellId('Target_DivineStrike_Melee_Nature_Cold') 
        --  | SpellId('Target_DivineStrike_Melee_Nature_Fire') 
        --  | SpellId('Target_DivineStrike_Melee_Nature_Lightning') 
        --  | SpellId('Target_DivineStrike_Melee_Tempest') 
        --  | SpellId('Target_DivineStrike_Melee_Trickery') 
        --  | SpellId('Target_DivineStrike_Melee_War') 
        --  | SpellId('Projectile_DivineStrike_Ranged_Life') 
        --  | SpellId('Projectile_DivineStrike_Ranged_Nature_Cold') 
        --  | SpellId('Projectile_DivineStrike_Ranged_Nature_Fire') 
        --  | SpellId('Projectile_DivineStrike_Ranged_Nature_Lightning') 
        --  | SpellId('Projectile_DivineStrike_Ranged_Tempest') 
        --  | SpellId('Projectile_DivineStrike_Ranged_Trickery') 
        --  | SpellId('Projectile_DivineStrike_Ranged_War')
    return IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Life')            -- Vanilla 2 electric boogaloo
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Nature_Cold') 
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Nature_Fire') 
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Nature_Lightning') 
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Tempest') 
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Trickery') 
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_War') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Life') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Nature_Cold') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Nature_Fire') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Nature_Lightning') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Tempest') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Trickery') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_War')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Death')           -- Patch #8
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Death')
         | IsSpellChildOrVariantFromContext('Projectile_BlessedStrikes')                 -- Expansion
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Nature_Cold_EXP')
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Nature_Cold_EXP')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Nature_Fire_EXP')
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Nature_Fire_EXP')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Nature_Lightning_EXP')
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Nature_Lightning_EXP')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Death_EXP')
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Death_EXP')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Trickery_EXP')
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Trickery_EXP')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_War_EXP')
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_War_EXP')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Life_EXP')
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Life_EXP')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Tempest_EXP')
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Tempest_EXP')
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Twilight')        -- 5e Cleric Subclasses Combined
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Twilight') 
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Order') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Order') 
         | IsSpellChildOrVariantFromContext('Target_DivineStrike_Melee_Forge') 
         | IsSpellChildOrVariantFromContext('Projectile_DivineStrike_Ranged_Forge')
	     | IsSpellChildOrVariantFromContext('TARGET_DIVINE_STRIKE_DARKNESS_DOMAIN')      -- Xarara
         | IsSpellChildOrVariantFromContext('PROJECTILE_DIVINE_STRIKE_DARKNESS_DOMAIN') 
         | IsSpellChildOrVariantFromContext('TARGET_DIVINE_STRIKE_DEATH_DOMAIN') 
         | IsSpellChildOrVariantFromContext('PROJECTILE_DIVINE_STRIKE_DEATH_DOMAIN')
end